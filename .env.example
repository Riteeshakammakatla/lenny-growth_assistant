# Copy this file to .env and fill in as needed. Never commit the real .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Overridden automatically inside docker-compose to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# --- LLM provider toggle (REQUIRED) ---
# "ollama"    -> mandatory local demo path, no API key needed, requires `ollama serve` running
# "anthropic" -> cloud path, requires ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# Cloud (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Local (only needed if LLM_PROVIDER=ollama, which is the default)
# Run `ollama pull llama3.1:8b` once before starting the app.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# Shared generation settings
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Knowledge base / retrieval ---
TRANSCRIPTS_DIR=./data/transcripts
# "local" = dependency-free hashed embeddings (default, works fully offline)
# "anthropic" = attempts Ollama's nomic-embed-text model for higher-quality retrieval
EMBEDDING_PROVIDER=local
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.15

# --- Artifacts ---
ARTIFACT_MAX_HTML_BYTES=200000

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
